# Supabase Project Credentials (Optional for local demo mode, required for cloud sync)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-key-here

# Hugging Face Model Options (default: j-hartmann/emotion-english-distilroberta-base or bhadresh-psavani/bert-base-uncased-emotion)
EMOTION_MODEL_NAME=j-hartmann/emotion-english-distilroberta-base

# Safety & Moderation Settings
ENABLE_SAFETY_GUARD=true
CRISIS_HELPLINE_PRIMARY=Tele-MANAS: 14416 (India) / 988 Lifeline (US/Canada)

# App Configuration
APP_ENV=development
APP_PORT=8501
